BOT_TOKEN=123456789:REEMPLAZA_ESTO
ADMIN_IDS=123456789
TIMEZONE=America/Mexico_City
DATABASE_PATH=botoneras.sqlite3

# category = cada botonera solo se publica en canales de su categoría
# all      = cada botonera se publica en todos los canales aprobados
DISTRIBUTE_MODE=category

MAX_BUTTONS_PER_BOARD=100
MIN_MEMBERS=5000

# Duración por defecto para categorías nuevas. Después se cambia desde /panel.
# Debe ser menor de 48h para garantizar deleteMessage.
DEFAULT_POST_LIFETIME_HOURS=6

# A la tercera falta el usuario queda bloqueado.
VIOLATION_LIMIT=3

# Cada cuántos segundos se comprueba que los posts activos siguen existiendo.
INTEGRITY_CHECK_SECONDS=300

# Cada cuántos segundos se comprueba qué publicaciones ya expiraron.
CLEANUP_CHECK_SECONDS=60

# Cuando llega al límite de faltas, sacar al bot de los demás canales del usuario.
LEAVE_CHANNELS_ON_BAN=true

# Cada cuántos segundos revisar automáticamente el número de suscriptores
# para detectar cambios de categoría. Mínimo aplicado por el código: 300s.
CATEGORY_CHECK_SECONDS=900

# Avisar al participante X minutos antes de la siguiente botonera.
UPCOMING_NOTICE_MINUTES=30

# --- v6: mantenimiento y robustez ---
# Backup consistente diario de SQLite usando la Online Backup API.
BACKUP_ENABLED=true
BACKUP_DIR=backups
BACKUP_HOUR=3
BACKUP_MINUTE=30
BACKUP_RETENTION_DAYS=14

# Auditoría periódica de permisos del bot en canales aprobados.
# Mínimo aplicado por el código: 300 segundos.
PERMISSION_CHECK_SECONDS=900


# ------------------------------------------------------------------
# v7 - Monetización / campañas patrocinadas con Telegram Stars
# ------------------------------------------------------------------
MONETIZATION_ENABLED=true
# Precio que paga el anunciante por cada 1,000 miembros objetivo, en Stars (XTR).
# AJUSTA este valor a tu modelo comercial antes de producción.
MONETIZATION_STARS_PER_1000=300
# 2000 = 20% para la plataforma; 80% queda como pool interno de participantes.
MONETIZATION_PLATFORM_FEE_BPS=2000
# Horas mínimas que una conversión debe permanecer para convertirse en ganancia válida.
MONETIZATION_RETENTION_HOURS=24
# Horas de reclutamiento entre aprobación del admin y comienzo de campaña.
MONETIZATION_OPPORTUNITY_HOURS=3
# Cierre de seguridad si una campaña no alcanza la meta.
MONETIZATION_MAX_CAMPAIGN_HOURS=72
# Retiro mínimo del monedero interno, expresado en Stars-equivalentes.
MONETIZATION_MIN_WITHDRAW_STARS=10
# Metas ofrecidas al anunciante.
MONETIZATION_GOALS=1000,2000,5000

# ------------------------------------------------------------------
# v7.2 - Promociones manuales USD + retiros USDT
# ------------------------------------------------------------------
# Retiro mínimo del saldo USD ganado en promociones manuales.
MONETIZATION_USDT_MIN_WITHDRAW_USD=50
# Comisión fija descontada del importe bruto solicitado.
MONETIZATION_USDT_FEE_USD=3
# Redes que el participante puede elegir al solicitar USDT.
# TRC20 valida direcciones T... de 34 caracteres.
# BEP20/ERC20 validan direcciones 0x... de 42 caracteres.
MONETIZATION_USDT_NETWORKS=TRC20,BEP20
